{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "stat",
      "title": "Total Predictions",
      "datasource": "Prometheus",
      "targets": [{"expr": "sum(heart_disease_predictions_total)", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}]}}}
    },
    {
      "type": "stat",
      "title": "Predictions: Disease vs No Disease",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum by (prediction)(heart_disease_predictions_total)", "refId": "A", "legendFormat": "{{prediction}}"}
      ],
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Request rate (req/s)",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum(rate(http_requests_total[1m]))", "refId": "A", "legendFormat": "rps"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Prediction latency (p50, p95, p99)",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "histogram_quantile(0.5, sum(rate(heart_disease_prediction_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(heart_disease_prediction_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(heart_disease_prediction_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}
    },
    {
      "type": "timeseries",
      "title": "HTTP errors per second",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m]))", "legendFormat": "5xx", "refId": "A"},
        {"expr": "sum(rate(http_requests_total{status=~\"4..\"}[1m]))", "legendFormat": "4xx", "refId": "B"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}
    }
  ],
  "schemaVersion": 39,
  "tags": ["heart-disease", "mlops"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "title": "Heart Disease API",
